{
  "compilerOptions": {
    // Cho phép viết `./geom.ts` trong import: script đối chiếu va chạm chạy thẳng bằng
    // Node (không qua Vite), mà Node ESM bắt buộc phải có đuôi file.
    "allowImportingTsExtensions": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client"]
  },
  "include": ["src"]
}
