{
  "name": "bladeascend-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run assets:build",
    "dev": "vite",
    "assets:build": "node ../tools/asset-pipeline/index.mjs",
    "build": "npm run assets:build && npm run assets:budget && npm run check:dead && npm run check:brand && npm run check:decode && npm run check:quality && tsc --noEmit && tsc --noEmit -p admin && vite build && npm run build:admin",
    "preview": "vite preview",
    "assets:report": "node --no-warnings scripts/assets-report.ts",
    "assets:size": "node --no-warnings --experimental-strip-types scripts/assets-size.ts",
    "assets:budget": "node --no-warnings --experimental-strip-types scripts/assets-budget.ts",
    "check:collision": "node --no-warnings --experimental-strip-types scripts/collision-check.ts",
    "check:telemetry-off": "node --no-warnings --experimental-strip-types scripts/telemetry-off.ts",
    "check:items": "node --no-warnings --experimental-strip-types scripts/items-check.ts",
    "check:assets": "node --no-warnings --experimental-strip-types scripts/assets-check.ts",
    "check:wire": "node --no-warnings --experimental-strip-types scripts/wire-check.ts",
    "check:dead": "node --no-warnings --experimental-strip-types scripts/assets-dead.ts",
    "check:brand": "node --no-warnings --experimental-strip-types scripts/brand-check.ts",
    "check:decode": "node --no-warnings --experimental-strip-types scripts/decode-fuzz.ts",
    "check:quality": "node --no-warnings --experimental-strip-types scripts/quality-check.ts",
    "perf:report": "python3 ../tools/perf-report/report.py",
    "build:admin": "vite build -c vite.admin.config.ts",
    "dev:admin": "vite -c vite.admin.config.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "antd": "5.29.3",
    "howler": "2.2.4",
    "pixi-filters": "^6.1.5",
    "pixi.js": "8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "revolt-fx": "^1.3.6"
  },
  "devDependencies": {
    "@types/howler": "2.2.13",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
